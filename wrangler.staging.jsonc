// Staging: bananapayserver-staging, which OBL's staging Worker calls over a service binding, and
// whose relay runs on signet. Limits and secrets are deliberately not here: set them in the
// deployment, never in this file. See docs/configuration.md.
//
// Deploy by hand with CLOUDFLARE_ACCOUNT_ID set; the account isn't named here. Local development
// runs this config too, under the same name, so a local OBL Worker's binding finds it; .dev.vars
// then overrides NETWORK for regtest.
{
	"name": "bananapayserver-staging",
	"main": "worker/index.mjs",
	"compatibility_date": "2026-09-30",
	// The relay dials its workers.dev address. Pages never call it directly.
	"workers_dev": true,
	"preview_urls": false,
	"observability": { "enabled": true },
	"durable_objects": {
		"bindings": [{ "name": "DONATIONS", "class_name": "Donations" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Donations"] }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bananapayserver-staging",
			// Set when the database is created; an id isn't a secret.
			"database_id": "REPLACE_WITH_D1_DATABASE_ID",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// Invoices and addresses for any other network are refused, so staging can't take mainnet
		// donations even if its relay is pointed at the wrong BTCPay.
		"NETWORK": "signet"
	}
}
