# Copy to .env in this folder and fill in. Never commit .env; keep it readable by its owner only.
# See docs/production.md.

# bananapayserver-production's line: wss://bananapayserver-production.<account subdomain>.workers.dev/relay
WORKER_URL=

# BTCPay as the relay reaches it on BTCPay's network: http://<BTCPay's container>:<the port it binds>
BTCPAY_URL=

# The Docker network BTCPay's container is on.
BTCPAY_NETWORK=

# The Tor SOCKS proxy BTCPay itself uses, as host:port: what BTCPAY_SOCKSENDPOINT says in BTCPay's
# container.
TOR_SOCKS=

# From BTCPay's pages: the donations store's id, an API key that can only create and view its
# invoices, and the webhook's secret.
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# Lightning threshold and request rate, from the team. Neither has a default.
LIGHTNING_MAX_SATS=
# Legacy fallback, only when LIGHTNING_MAX_SATS is absent (not empty):
# MAX_SATS=
RATE_PER_MINUTE=

# Written by token.sh.
RELAY_TOKEN=
