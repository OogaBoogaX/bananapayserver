# Copy to .env in this folder and fill in. Never commit .env. setup.sh adds the relay's
# settings to it and makes it readable by its owner only. See docs/staging.md.

# The stack's three networks, and Tor's address on the first two. Pick ranges no other network
# on this machine uses.
BACKEND_SUBNET=172.31.240.0/24
FRONT_SUBNET=172.31.241.0/24
OUTSIDE_SUBNET=172.31.242.0/24
TOR_BACKEND_IP=172.31.240.10
TOR_FRONT_IP=172.31.241.10

# Mutinynet's seed node, host:port, from mutinynet's own documentation.
SIGNET_PEER=

# Fresh random values, made here and used nowhere else, for example with: openssl rand -hex 24
BITCOIN_RPC_USER=staging
BITCOIN_RPC_PASSWORD=
POSTGRES_PASSWORD=

# bananapayserver-staging's line: wss://bananapayserver-staging.<account subdomain>.workers.dev/relay
WORKER_URL=

# The relay's own cap, in sats, and how many invoices and on-chain addresses it makes in a
# minute, from the team. Neither has a default.
RELAY_MAX_SATS=
RELAY_RATE_PER_MINUTE=

# Written by setup.sh.
RELAY_TOKEN=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=
BTCPAY_ADMIN_PASSWORD=
