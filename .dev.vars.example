# Copy to .dev.vars for local development with wrangler. Never commit .dev.vars.
# Limits have no defaults on purpose: donations stay closed until each one is set.
MAX_SATS=
RATE_PER_IP=
RATE_GLOBAL=
# SHA-256, in hex, of the relay's token.
RELAY_TOKEN_SHA256=
NETWORK=regtest
ALLOWED_ORIGINS=http://localhost:8000
# GitHub sign-in: an OAuth app whose callback is http://localhost:8787/auth/github/callback,
# and a session key of at least 32 characters. Leave them empty to run without sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_KEY=
