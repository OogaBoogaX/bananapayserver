# Copy to .dev.vars for local development with wrangler. Never commit .dev.vars.
# Limits have no defaults on purpose: donations stay closed until each one is set.
MAX_SATS=
RATE_PER_IP=
RATE_GLOBAL=
SOCKETS_PER_IP=
# SHA-256, in hex, of the relay's token.
RELAY_TOKEN_SHA256=
# Overrides the staging config's signet for the local regtest stack.
NETWORK=regtest
