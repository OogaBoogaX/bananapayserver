# Copy to .env for the relay's container. Never commit .env. See docs/configuration.md.

# The Worker's line address, and the relay's token. The Worker holds only the token's SHA-256.
WORKER_URL=wss://api.example.org/relay
RELAY_TOKEN=

# Tor's SOCKS proxy, as host:port. DIRECT=yes connects without Tor, for development only.
TOR_SOCKS=

# BTCPay on the machine's internal network, and a key that can only create and view
# invoices on one store.
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# The relay's own cap, in sats, and how many invoices and on-chain addresses it makes in a
# minute. Neither has a default: the relay won't start without them.
MAX_SATS=
RATE_PER_MINUTE=

# Optional.
# MIN_SATS=1
# WEBHOOK_LISTEN=0.0.0.0:8080
# INVOICE_MINUTES=15
# LIGHTNING_METHOD=BTC-LN
# ONCHAIN_METHOD=BTC-CHAIN
